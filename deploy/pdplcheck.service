[Unit]
Description=PDPLCheck Gulf Privacy Readiness Studio (UAE 45/2021 & KSA SDAIA PDPL)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pdplcheck
EnvironmentFile=/etc/pdplcheck/.env
ExecStart=/usr/bin/node --no-warnings /opt/pdplcheck/server/index.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
