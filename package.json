{
  "name": "pdplcheck",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "UAE Federal Decree-Law 45/2021 & KSA SDAIA PDPL RoPA auditor, cross-border transfer checker, 72h breach triage timer, and bilingual privacy notice builder.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4200",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4200",
    "start": "node --no-warnings server/index.mjs",
    "start:lan": "HOST=0.0.0.0 PORT=4199 node --no-warnings server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
